{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TradingView Local Skins v1 palette",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "name", "palette"],
  "properties": {
    "version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$" },
    "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]{0,59}$" },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "required": ["background", "surface", "border", "text", "muted", "accent", "hover"],
      "properties": {
        "background": { "$ref": "#/$defs/color" },
        "surface": { "$ref": "#/$defs/color" },
        "border": { "$ref": "#/$defs/color" },
        "text": { "$ref": "#/$defs/color" },
        "muted": { "$ref": "#/$defs/color" },
        "accent": { "$ref": "#/$defs/color" },
        "hover": { "$ref": "#/$defs/color" }
      }
    }
  },
  "$defs": { "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" } }
}
